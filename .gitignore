# =========================================================

.ipynb_checkpoints/


# =========================================================
# Machine Learning - Generated / Large Files
# =========================================================

# NumPy arrays - training/preprocessing outputs
*.npy

# Serialized ML objects / caches
*.pkl
*.joblib

# PyTorch checkpoints
*.pt
*.pth

# HDF5 models
*.h5

# Compressed archives
*.zip
*.tar
*.gz

# Generated datasets / temporary data
data/


# =========================================================
# Secrets & Environment Variables
# =========================================================

.env
.env.*
!.env.example

backend/.env
frontend/.env
frontend/.env.local


